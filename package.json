{
  "name": "zotero-timeline",
  "type": "module",
  "version": "0.1.0",
  "description": "Zotero 8-10 plugin for authoring research timelines and chronologies, where every event cites sources from your own library.",
  "config": {
    "addonName": "Zotero Timeline",
    "addonID": "zoterotimeline@oekeur.github.io",
    "addonRef": "zoterotimeline",
    "addonInstance": "ZoteroTimeline",
    "prefsPrefix": "extensions.zotero.zoterotimeline"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oekeur/zotero-timeline.git"
  },
  "homepage": "https://github.com/oekeur/zotero-timeline",
  "bugs": {
    "url": "https://github.com/oekeur/zotero-timeline/issues"
  },
  "author": "Oscar Keur",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "prepare": "husky",
    "clean:profile": "node scripts/clean-dev-profile.mjs",
    "prestart": "node scripts/clean-dev-profile.mjs",
    "start": "zotero-plugin serve",
    "start:headless": "node scripts/headless.mjs npm start",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "node scripts/headless.mjs npx zotero-plugin test",
    "test:fast": "node scripts/headless.mjs node scripts/run-tests.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "update-deps": "npm update --save",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test"
  },
  "dependencies": {
    "edtf": "4.11.1",
    "vis-timeline": "8.5.4",
    "zotero-plugin-toolkit": "6.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.4",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "chai": "^6.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "4.1.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,mjs,cjs,json,md,css,xhtml}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  },
  "private": true
}
