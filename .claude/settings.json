{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/pre-merge-test-gate.sh\"",
            "if": "Bash(git merge *)",
            "timeout": 780,
            "statusMessage": "Running full test suite before merge to main..."
          }
        ]
      }
    ]
  }
}
